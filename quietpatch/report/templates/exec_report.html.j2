<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>QuietPatch • Executive Summary</title>
<style>
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; color:#0b1221; }
  .wrap { max-width: 820px; margin: 24px auto; padding: 0 12px; }
  h1,h2 { margin: 0.6rem 0; }
  .kpis { display:grid; grid-template-columns: repeat(4, 1fr); gap:10px; }
  .tile { border:1px solid #e4e7ef; border-radius:12px; padding:10px; background:#fff; text-align:center;}
  .tile .num { font-size:22px; font-weight:700; }
  .muted { color:#596179; font-size: 12px; }
  .card { border:1px solid #e4e7ef; border-radius:12px; padding:12px; background:#fff; margin-top:12px;}
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size:12px; }
  table { width:100%; border-collapse:collapse; font-size: 13px; }
  th, td { border-bottom:1px solid #eef1f7; padding:8px; text-align:left; vertical-align:top; }
  th { background:#f8f9fc; font-weight:600; }
  .footer { margin-top: 18px; font-size: 11px; color:#6a728b; }
  .wm {
    position: fixed; z-index: 9999; top: 18px; right: 18px;
    padding: 6px 10px; border:1px dashed #9aa3b2; border-radius:10px;
    background: #f5f7fb; color:#3a4154; font-weight:700; font-size:12px;
    opacity: 0.9;
  }
</style>
</head>
<body>
{% if watermark %}
<div class="wm">{{ watermark }}</div>
{% endif %}
<div class="wrap">
  <h1>QuietPatch • Executive Summary</h1>
  <div class="muted">Run: <span class="mono">{{ run }}</span> • Generated: {{ now }}</div>

  <div class="kpis" style="margin-top:12px;">
    <div class="tile"><div class="muted">Assets Scanned</div><div class="num">{{ kpi.assets_scanned }}</div></div>
    <div class="tile"><div class="muted">Exposure Index</div><div class="num">{{ "%.2f"|format(kpi.exposure_index) }}</div></div>
    <div class="tile"><div class="muted">KEV Backlog</div><div class="num">{{ kpi.kev_backlog }}</div></div>
    <div class="tile"><div class="muted">Critical ≤7d SLA</div><div class="num">{{ "%.0f"|format(kpi.sla.critical_7d*100) }}%</div></div>
  </div>

  <div class="card">
    <h2>Trend</h2>
    <div>{{ spark_svg | safe }}</div>
    <div class="muted">Exposure index over recent runs (lower is better)</div>
  </div>

  <div class="card">
    <h2>Severity Mix</h2>
    <table>
      <thead><tr><th>Critical</th><th>High</th><th>Medium</th><th>Low</th></tr></thead>
      <tbody>
        <tr>
          <td>{{ vulns_by_sev.critical }}</td>
          <td>{{ vulns_by_sev.high }}</td>
          <td>{{ vulns_by_sev.medium }}</td>
          <td>{{ vulns_by_sev.low }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Next Actions</h2>
    <ol>
      <li>Close KEV backlog ({{ kpi.kev_backlog }}) with canary rollout and dual-approval this week.</li>
      <li>Drive Critical ≤7d SLA from {{ "%.0f"|format(kpi.sla.critical_7d*100) }}% → 95% with targeted maintenance windows.</li>
      <li>Publish signed remediation bundle and attach audit evidence to change record.</li>
    </ol>
  </div>

  {% if approval %}
  <div class="card">
    <h2>Approval</h2>
    <div class="mono">
      {{ approval.change_id }} • {{ approval.approver_1.name }}; {{ approval.approver_2.name }} • {{ approval.approver_2.date }}
    </div>
  </div>
  {% endif %}

  <div class="card">
    <h2>Audit Proof</h2>
    <div>Catalog Signed: <b>{{ "yes" if catalog.signed else "no" }}</b></div>
    <div>Document SHA256: <span class="mono">{{__DOC_SHA256__}}</span></div>
  </div>

  <div class="footer">
    Deterministic report generated offline by QuietPatch.
  </div>
</div>
</body>
</html>
