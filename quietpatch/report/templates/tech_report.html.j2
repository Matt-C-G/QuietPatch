<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>QuietPatch • Technical Report</title>
<style>
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; color:#0b1221; }
  .wrap { max-width: 1080px; margin: 24px auto; padding: 0 12px; }
  h1,h2,h3 { margin: 0.6rem 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .card { border:1px solid #e4e7ef; border-radius:12px; padding:12px 14px; background:#fff; }
  .muted { color:#596179; font-size: 12px; }
  table { width:100%; border-collapse:collapse; font-size: 13px; }
  th, td { border-bottom:1px solid #eef1f7; padding:8px; text-align:left; vertical-align:top; }
  th { background:#f8f9fc; font-weight:600; }
  .sev-critical { color:#a10000; font-weight:700; }
  .sev-high { color:#c53; font-weight:700; }
  .sev-medium { color:#b67; }
  .sev-low { color:#678; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size:12px; }
  .footer { margin-top: 24px; font-size: 11px; color:#6a728b; }
  .pill { display:inline-block; padding:2px 8px; border-radius:999px; border:1px solid #e4e7ef; font-size:11px; }
  .wm {
    position: fixed; z-index: 9999; top: 18px; right: 18px;
    padding: 6px 10px; border:1px dashed #9aa3b2; border-radius:10px;
    background: #f5f7fb; color:#3a4154; font-weight:700; font-size:12px;
    opacity: 0.9;
  }
</style>
</head>
<body>
{% if watermark %}
<div class="wm">{{ watermark }}</div>
{% endif %}
<div class="wrap">
  <h1>QuietPatch • Technical Report</h1>
  <div style="position:relative;margin:8px 0;padding:6px 10px;border:1px solid #5d9; border-radius:6px;
              display:inline-block;background:#0a2; color:#fff; font-weight:600; letter-spacing:.3px;">
    DEMO • SANITIZED DATA
  </div>
  <div style="position:absolute;top:8px;right:12px;padding:4px 8px;border:1px solid #4a9; border-radius:6px;
              background:#4a9; color:#fff; font-weight:600; font-size:11px; letter-spacing:.3px;">
    APPROVED • CAB-TEST-001
  </div>
  <div class="muted">Run: <span class="mono">CAB-TEST-001</span> • Catalog: <span class="mono">v2025.10.02</span> • Policy: <span class="mono">v0.5.1</span> • Generated: {{ now }}</div>

  <div class="grid" style="margin-top:12px;">
    <div class="card">
      <h3>Overview</h3>
      <div>Assets scanned: <b>1</b></div>
      <div>Exposure index: <b>0.3</b> <span class="muted">(0–1; lower is better)</span></div>
      <div>KEV items: <b>0</b></div>
      <div>Bundle SHA256: <span class="mono">7b1…d4e</span></div>
      <div>Catalog signed: <b>yes (minisign ED25519 7S3…Q2)</b></div>
    </div>
    <div class="card">
      <h3>Severity & BU Distribution</h3>
      <div>{{ charts.sev_svg | safe }}</div>
      <div style="height:8px"></div>
      <div>{{ charts.heat_svg | safe }}</div>
    </div>
  </div>

  <div class="card" style="margin-top:12px;">
    <h3>Rollback Rehearsal</h3>
    <div class="mono" style="background:#f8f9fc; padding:8px; border-radius:6px; font-size:11px;">
      <div><strong>Canary cohort:</strong> demo-mac (1)</div>
      <div><strong>Change ID:</strong> CAB-TEST-001</div>
      <div><strong>Backout target:</strong> OpenSSL 3.0.14 → 3.0.0</div>
      <div><strong>Health checks:</strong> brew doctor clean; CLI probe OK</div>
      <div><strong>Outcome:</strong> PASSED (00:02:10)</div>
      <div><strong>Evidence hash:</strong> 9c0…c7a</div>
    </div>
  </div>

  <div class="card" style="margin-top:12px;">
    <h2>Findings & Fixes</h2>
    <table>
      <thead>
        <tr>
          <th>BU</th><th>Asset</th><th>OS</th><th>Package</th><th>CVE</th><th>Sev</th><th>KEV/EPSS</th><th>Fix</th><th>Commands</th>
        </tr>
      </thead>
      <tbody>
      {% for a in assets %}
        {% for v in a.vulns %}
        <tr>
          <td>{{ a.bu or "(unassigned)" }}</td>
          <td class="mono">{{ a.hostname or a.asset_id }}</td>
          <td>{{ a.os }}</td>
          <td class="mono">{{ v.package or "-" }} {{ v.current_version or "" }}</td>
          <td class="mono">{{ v.cve }}</td>
          <td class="sev-{{ v.severity|lower }}">{{ v.severity|title }}</td>
          <td>
            {% if v.kev %}<span class="pill">KEV</span>{% endif %}
            {% if v.epss %}<span class="pill">EPSS {{ "%.2f"|format(v.epss) }}</span>{% endif %}
          </td>
          <td>
            {% if v.fix_available %}
              → {{ v.fix.target_version }}
            {% else %}
              (no vendor fix)
            {% endif %}
          </td>
          <td class="mono">
            {% if v.fix_available %}
              # install<br/>brew upgrade openssl<br/><br/>
              # verify<br/>openssl version<br/><br/>
              # backout (if canary fails)<br/>brew downgrade openssl 3.0.0 && openssl version
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="grid" style="margin-top:12px;">
    <div class="card">
      <h3>Policy Decisions</h3>
      <div class="muted">Version: v0.5.1</div>
      <ul>
        <li class="mono">• min_severity = high</li>
        <li class="mono">• treat_unknown_as = alert</li>
        <li class="mono">• change_window = Fri 19:00–19:30 ET</li>
      </ul>
    </div>
    <div class="card">
      <h3>Run Diff (vs previous)</h3>
      <div>Added: <b>{{ diff.added }}</b> • Removed: <b>{{ diff.removed }}</b> • Net: <b>{{ diff.net }}</b></div>
      <div class="muted">Previous run omitted if not supplied.</div>
    </div>
  </div>

  <div class="card" style="margin-top:12px;">
    <h3>Change Approval</h3>
    <div class="mono" style="font-size:12px;">
      <div><strong>Change ID:</strong> CAB-TEST-001</div>
      <div><strong>Submitted by:</strong> demo</div>
      <div><strong>Approver 1:</strong> Demo User — 2025-10-02T10:00Z</div>
      <div><strong>Approver 2:</strong> Demo Change Board — 2025-10-02T10:30Z</div>
      <div><strong>Decision:</strong> APPROVED</div>
      <div><strong>Scope:</strong> Demo approval for mock vulnerability remediation</div>
    </div>
  </div>

  <div class="card" style="margin-top:12px;">
    <h3>Rollback Runbook (summary)</h3>
    <div class="mono" style="font-size:12px;">
      <div>1) <strong>Stop condition:</strong> fail any health check or policy gate.</div>
      <div>2) <strong>Backout:</strong> restore package(s) to pinned version(s) listed above.</div>
      <div>3) <strong>Verification:</strong> rerun health checks; compare footer hash.</div>
      <div>4) <strong>Reopen ticket</strong> with "Rollback-PASSED/FAILED" and attach transcript.</div>
      <div>5) <strong>Approval:</strong> CAB approver sign-off recorded below.</div>
    </div>
  </div>

  <div class="footer">
    <div><strong>Report SHA256:</strong> <span class="mono">3f9…a8c</span></div>
  </div>
</div>
</body>
</html>
