      "product": "iTerm2",
      "display_name": "iTerm2",
      "bundle_id": "com.googlecode.iterm2",
      "app_path": "/Applications/iTerm.app",
      "current_version": "3.5.10",
      "target_version": "3.5.12",
      "artifact": "artifacts/mac/iterm2-3.5.12.pkg",
      "rollback_artifact": "artifacts/mac/iterm2-3.5.10.pkg",
      "install_cmd": "sudo installer -pkg \"{{artifact}}\" -target /",
      "rollback_cmd": "sudo installer -pkg \"{{rollback_artifact}}\" -target /",
      "verify": {
        "type": "app_bundle_version",
        "path": "/Applications/iTerm.app",
        "version": "3.5.12"
      },
      "sha256": {
        "artifact": "<FILL_AT_BUILD>",
        "rollback_artifact": "<FILL_AT_BUILD>"
      }
    },
    {
      "os": "linux",
      "product": "Visual Studio Code",
      "display_name": "VS Code",
      "package_name": "code",
      "current_version": "1.91.0",
      "target_version": "1.93.1",
      "artifact": "artifacts/linux/vscode_1.93.1_amd64.deb",
      "rollback_artifact": "artifacts/linux/vscode_1.91.0_amd64.deb",
      "install_cmd": "sudo dpkg -i \"{{artifact}}\" || sudo apt-get -f install -y",
      "rollback_cmd": "sudo dpkg -i \"{{rollback_artifact}}\" || sudo apt-get -f install -y",
