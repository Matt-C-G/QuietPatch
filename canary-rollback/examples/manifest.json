      "rollback_cmd": "msiexec /i \"{{rollback_artifact}}\" /qn /norestart",
      "verify": {
        "type": "file_version",
        "path": "C:\\\\Program Files\\\\7-Zip\\\\7z.exe",
        "version": "23.01"
